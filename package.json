{
  "name": "fake-linkedin-reporter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Crowd-sourced fake LinkedIn profile reporting: browser extension + API.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "dev:api": "bun run --cwd apps/worker dev",
    "dev:ext": "bun run --cwd apps/extension dev",
    "dev:ext:firefox": "bun run --cwd apps/extension dev:firefox",
    "build:ext": "bun run --cwd apps/extension build:all",
    "db:init:local": "bun run --cwd apps/worker db:init:local",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "capture": "bun tools/capture/capture.ts",
    "check": "bun run typecheck && bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
